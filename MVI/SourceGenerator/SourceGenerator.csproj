<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.1" />
    </ItemGroup>

    <Target Name="PublishUnityAnalyzer" AfterTargets="Build">
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="..\Assets\Scripts\MVI\Analyzers" SkipUnchangedFiles="true" />
    </Target>

</Project>
